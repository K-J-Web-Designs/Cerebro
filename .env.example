# Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database (Supabase Postgres Connection String; falls back to embedded PGlite when unset)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# AI Provider (Google Gemini is default; falls back to local deterministic heuristic when unset)
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAlex Polite Pool (improves rate limits for Topic Explorer)
OPENALEX_POLITE_EMAIL=
